# BaÄŸlantÄ± deneme sayÄ±sÄ± (baÄŸlantÄ± kurulamazsa kaÃ§ kez tekrar deneneceÄŸi). VarsayÄ±lan: 8
# DB_CONNECTION_RETRIES=8

# Denemeler arasÄ± bekleme sÃ¼resi (ms). VarsayÄ±lan: 2000
# DB_CONNECTION_RETRY_DELAY=2000

# ============================================
# SUNUCU AYARLARI
# ============================================

# API sunucu portu (varsayÄ±lan: 5000)
PORT=5000

# Node.js ortamÄ± (development, production, test)
# Production'da mutlaka "production" olarak ayarlayÄ±n!
NODE_ENV=development

# ============================================
# CORS AYARLARI
