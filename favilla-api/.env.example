# Ä°zin verilen origin'ler (virgÃ¼lle ayrÄ±lmÄ±ÅŸ)
# Development iÃ§in localhost otomatik eklenir
# Production'da mutlaka belirtin!
# Ã–rnek: http://localhost:3000,https://favilla.com,https://www.favilla.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ============================================
# LOGLAMA AYARLARI (Opsiyonel)
# ============================================

# Log seviyesi (error, warn, info, http, debug)
# Production'da "info" veya "warn" Ã¶nerilir
# Development'da "debug" kullanÄ±labilir
LOG_LEVEL=debug

# ============================================
# GÃœVENLÄ°K AYARLARI (Opsiyonel)
# ============================================

# Request body size limiti (DoS korumasÄ±)
# Ã–rnekler: 1mb, 500kb, 2mb
# VarsayÄ±lan: 1mb
BODY_SIZE_LIMIT=1mb

