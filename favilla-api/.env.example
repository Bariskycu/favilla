# JWT Secret Key
# âš ï¸  Ã–NEMLÄ°: En az 32 karakter olmalÄ±dÄ±r!
# GÃ¼venli bir secret oluÅŸturmak iÃ§in: openssl rand -base64 32
# Production'da mutlaka gÃ¼Ã§lÃ¼ bir deÄŸer kullanÄ±n!
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this-in-production

# ============================================
# VERÄ°TABANI AYARLARI (PostgreSQL)
# ============================================

# VeritabanÄ± sunucu adresi
DB_HOST=localhost

# VeritabanÄ± portu (PostgreSQL varsayÄ±lan: 5432)
DB_PORT=5432

# VeritabanÄ± adÄ±
DB_DATABASE=favilla_db

# VeritabanÄ± kullanÄ±cÄ± adÄ±
DB_USER=your_db_user

# VeritabanÄ± ÅŸifresi
